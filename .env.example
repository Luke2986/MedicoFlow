# Opzionale: stringa di connessione PostgreSQL (locale, Docker, Supabase, Neon, ...).
# Se manca, l'app usa un database in memoria con dati di esempio: comodo per provarla,
# ma tutto si perde quando il server si riavvia.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medicoflow

# Solo senza DATABASE_URL: metti "false" per partire con l'ambulatorio vuoto invece dei dati di esempio.
DEMO_DATA=

# Obbligatoria con un database esterno: chiave segreta per firmare le sessioni di login.
# Generala con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Indirizzo pubblico dell'app (es. https://studio.example.it). In locale non serve.
# Su Vercel, se vuota, viene usato il dominio di produzione del progetto.
BETTER_AUTH_URL=

# Porta del server (opzionale, default 5000)
PORT=5000

# Opzionale: abilita la dettatura vocale (trascrizione audio)
GROQ_API_KEY=

# Opzionale: abilita le rotte admin (es. GET /api/pricing-leads) con header "Authorization: Bearer <token>".
# Se vuota, le rotte admin rispondono 404.
ADMIN_TOKEN=

# Opzionale: numero di reverse proxy davanti al server (es. 1 dietro Nginx), per leggere l'IP reale del client.
# Su Vercel è impostato automaticamente.
TRUST_PROXY=
