{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{migrations/**,node_modules/pdfkit/js/standard-fonts/**,node_modules/pdfkit/js/data/**,node_modules/@electric-sql/pglite/dist/*.{wasm,data}}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
